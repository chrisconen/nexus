# ============================================================
# NEXUS — környezeti változók sablonja
# Másold .env.local néven, és töltsd ki az értékeket.
# A beszerzési helyek: ENV-HELYREALLITAS.md
# SOHA ne commitolj kitöltött .env fájlt!
# ============================================================

# --- URL-ek ---
# Lokális dev: http://localhost:4321 | Éles: https://app.conendigital.hu
PUBLIC_APP_URL=http://localhost:4321
BETTER_AUTH_URL=http://localhost:4321
PUBLIC_AUTH_URL=http://localhost:4321

# --- Better Auth ---
# Tetszőleges hosszú véletlen string (pl. openssl rand -base64 32)
BETTER_AUTH_SECRET=

# --- Turso DB ---
# Dev: dev-nexus | Éles: nexus — https://app.turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- AI modellek ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GOOGLE_API_KEY=
GOOGLE_MODEL=

# --- Stripe ---
# Lokálhoz TESZT kulcsot (sk_test_...), élesben live kulcsot!
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
STRIPE_WEBHOOK_SECRET=

# --- Resend (email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@conendigital.hu
RESEND_FROM_NAME=NEXUS

# --- Vercel Blob (képfeltöltés) ---
BLOB_READ_WRITE_TOKEN=

# --- Kapcsolók ---
PREMIUM_CHECKOUT_ENABLED=false
DATA_LOGGING_ENABLED=false

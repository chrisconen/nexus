---
import { LOCALE_LABELS, LOCALE_SHORT, type Locale } from "@/lib/i18n/translations";
import { localizedUrl } from "@/lib/i18n/locale";

export interface Props {
  currentLocale: Locale;
  currentPathname: string;
}

const { currentLocale, currentPathname } = Astro.props as Props;
const locales: Locale[] = ['hu', 'en', 'de'];
---

<div class="language-switcher">
  {locales.map((loc) => {
    const url = localizedUrl(currentPathname, loc, currentLocale);
    const isActive = loc === currentLocale;
    return (
      <a
        href={url}
        class={`lang-btn ${isActive ? 'active' : ''}`}
        aria-label={LOCALE_LABELS[loc]}
        hreflang={loc}
      >
        {LOCALE_SHORT[loc]}
      </a>
    );
  })}
</div>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.15s ease;
    color: #71717a;
    border: 1px solid transparent;
  }
  .lang-btn:hover {
    color: #d4d4d8;
    border-color: #3f3f46;
  }
  .lang-btn.active {
    color: #34d399;
    border-color: #34d399;
    background: rgba(5, 150, 105, 0.08);
  }
</style>

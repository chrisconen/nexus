---
import "../../styles/global.css";
import { auth } from "@/lib/auth";
import BugReport from "@/components/BugReport.astro";
import { t, type Locale } from "@/lib/i18n/translations";
import { localeRelativePath } from "@/lib/i18n/locale";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

const locale = (Astro.currentLocale as Locale) || "hu";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

const isLoggedIn = !!session;
const currentTier = (session?.user.tier ?? null) as "free" | "pro" | "premium" | null;
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t(locale, "pricing.title")}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-mono antialiased">
    <div class="min-h-screen flex flex-col px-6 py-12">
      <div class="max-w-6xl w-full mx-auto flex-1 flex flex-col">

        <!-- Fejléc -->
        <div class="mb-12 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
            <span class="text-xs uppercase tracking-[0.3em] text-zinc-500">{t(locale, "pricing.system")}</span>
            <LanguageSwitcher currentLocale={locale} currentPathname={Astro.url.pathname} />
          </div>
          <a href={localeRelativePath(isLoggedIn ? "/fiok" : "/", locale)} class="text-xs text-zinc-500 hover:text-emerald-400 transition-colors">
            {t(locale, "pricing.back", { link: t(locale, isLoggedIn ? "pricing.backLogin" : "pricing.backHome") })}
          </a>
        </div>

        <h1 class="text-4xl font-light mb-2">
          <span class="text-zinc-400">{t(locale, "pricing.heading")}</span>
          <span class="text-emerald-400">{t(locale, "pricing.headingAccent")}</span>
        </h1>
        <p class="text-sm text-zinc-500 mb-12">
          {t(locale, "pricing.subtitle")}
        </p>

        <!-- Árazó kártyák -->
        <div class="grid md:grid-cols-3 gap-6">

          <!-- FREE -->
          <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/60 backdrop-blur-sm flex flex-col relative">
            {currentTier === "free" && (
              <div class="absolute -top-3 left-6 bg-zinc-700 text-zinc-200 text-xs uppercase tracking-wider px-2 py-1 rounded">
                {t(locale, "pricing.free.badgeCurrent")}
              </div>
            )}
            <div class="text-xs uppercase tracking-wider text-zinc-500 mb-3">Free</div>
            <div class="text-2xl font-light text-zinc-200 mb-1">{t(locale, "pricing.free.name")}</div>
            <div class="text-xs text-zinc-500 mb-6">{t(locale, "pricing.free.limit")}</div>

            <div class="text-sm text-zinc-300 mb-4">
              <strong class="text-emerald-400">NEXUS AI</strong>
              <span class="text-zinc-500"> · {t(locale, "pricing.free.model")}</span>
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              {t(locale, "pricing.free.desc")}
            </p>

            <ul class="text-xs text-zinc-400 space-y-2 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.free.item1")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.free.item2")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.free.item3")}</span>
              </li>
              <li class="flex items-start gap-2 text-zinc-600">
                <span class="mt-0.5">·</span>
                <span>{t(locale, "pricing.free.item4")}</span>
              </li>
            </ul>

            {!isLoggedIn && (
              <a href={localeRelativePath("/regisztracio", locale)} class="block text-center bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2.5 rounded text-sm font-medium transition-colors">
                {t(locale, "pricing.free.cta")}
              </a>
            )}
            {isLoggedIn && currentTier === "free" && (
              <div class="block text-center bg-zinc-800/50 text-zinc-500 px-4 py-2.5 rounded text-sm font-medium">
                {t(locale, "pricing.free.active")}
              </div>
            )}
            {isLoggedIn && currentTier !== "free" && (
              <div class="block text-center text-zinc-600 px-4 py-2.5 text-xs">
                {t(locale, "pricing.free.always")}
              </div>
            )}
          </div>

          <!-- PRO -->
          <div class="border border-emerald-700 rounded-lg p-6 bg-emerald-950/20 backdrop-blur-sm flex flex-col relative">
            {currentTier === "pro" ? (
              <div class="absolute -top-3 left-6 bg-emerald-600 text-zinc-100 text-xs uppercase tracking-wider px-2 py-1 rounded">
                {t(locale, "pricing.pro.badgeCurrent")}
              </div>
            ) : (
              <div class="absolute -top-3 left-6 bg-emerald-600 text-zinc-100 text-xs uppercase tracking-wider px-2 py-1 rounded">
                {t(locale, "pricing.pro.badgePopular")}
              </div>
            )}
            <div class="text-xs uppercase tracking-wider text-emerald-400 mb-3">{t(locale, "pricing.pro.name")}</div>
            <div class="text-2xl font-light text-zinc-100 mb-1">{t(locale, "pricing.pro.price")}</div>
            <div class="text-xs text-zinc-500 mb-6">{t(locale, "pricing.pro.period")}</div>

            <div class="text-sm text-zinc-300 mb-4">
              <strong class="text-emerald-400">NEXUS {t(locale, "pricing.pro.name")}</strong>
              <span class="text-zinc-500"> · {t(locale, "pricing.pro.model")}</span>
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              {t(locale, "pricing.pro.desc")}
            </p>

            <ul class="text-xs text-zinc-400 space-y-2 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.pro.item1")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.pro.item2")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.pro.item3")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.pro.item4")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.pro.item5")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.pro.item6")}</span>
              </li>
            </ul>

            {!isLoggedIn && (
              <a href={localeRelativePath("/regisztracio", locale)} class="block text-center bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2.5 rounded text-sm font-medium transition-colors">
                {t(locale, "pricing.pro.ctaRegister")}
              </a>
            )}
            {isLoggedIn && currentTier === "pro" && (
              <div class="block text-center bg-zinc-800/50 text-zinc-500 px-4 py-2.5 rounded text-sm font-medium">
                {t(locale, "pricing.pro.active")}
              </div>
            )}
            {isLoggedIn && currentTier !== "pro" && (
              <button
                type="button"
                data-checkout-tier="pro"
                class="checkout-btn block w-full text-center bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2.5 rounded text-sm font-medium transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {currentTier === "premium" ? t(locale, "pricing.pro.switchToPro") : t(locale, "pricing.pro.subscribe")}
              </button>
            )}
          </div>

          <!-- PREMIUM -->
          <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/60 backdrop-blur-sm flex flex-col relative">
            {currentTier === "premium" ? (
              <div class="absolute -top-3 left-6 bg-zinc-700 text-zinc-200 text-xs uppercase tracking-wider px-2 py-1 rounded">
                {t(locale, "pricing.premium.badgeCurrent")}
              </div>
            ) : (
              <div class="absolute -top-3 left-6 bg-amber-600 text-zinc-100 text-xs uppercase tracking-wider px-2 py-1 rounded">
                {t(locale, "index.pricing.premium.badge")}
              </div>
            )}
            <div class="text-xs uppercase tracking-wider text-zinc-400 mb-3">{t(locale, "pricing.premium.name")}</div>
            <div class="text-2xl font-light text-zinc-100 mb-1">{t(locale, "pricing.premium.price")}</div>
            <div class="text-xs text-zinc-500 mb-6">{t(locale, "pricing.premium.period")}</div>

            <div class="text-sm text-zinc-300 mb-4">
              <strong class="text-emerald-400">NEXUS {t(locale, "pricing.premium.name")}</strong>
              <span class="text-zinc-500"> · {t(locale, "pricing.premium.model")}</span>
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              {t(locale, "pricing.premium.desc")}
            </p>

            <ul class="text-xs text-zinc-400 space-y-2 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.premium.item1")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.premium.item2")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.premium.item3")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.premium.item4")}</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-500 mt-0.5">✓</span>
                <span>{t(locale, "pricing.premium.item5")}</span>
              </li>
            </ul>

            {currentTier === "premium" ? (
              <div class="block text-center bg-zinc-800/50 text-zinc-500 px-4 py-2.5 rounded text-sm font-medium">
                {t(locale, "pricing.premium.active")}
              </div>
            ) : (
              <div class="block text-center border border-zinc-700 text-zinc-500 px-4 py-2.5 rounded text-sm font-medium cursor-default">
                {t(locale, "index.pricing.premium.cta")}
              </div>
            )}
          </div>

        </div>

        <!-- ÉLESÍTÉS CSOMAG -->
        <div class="mt-10 border border-amber-700/60 rounded-lg p-8 bg-amber-950/10 backdrop-blur-sm">
          <div class="flex flex-wrap items-start justify-between gap-6">
            <div class="max-w-xl">
              <div class="text-xs uppercase tracking-[0.2em] text-amber-500 mb-2">{t(locale, "index.golive.badge")}</div>
              <h3 class="text-xl text-zinc-200 mb-3">🚀 {t(locale, "index.golive.title")}</h3>
              <p class="text-sm text-zinc-400 leading-relaxed mb-4">{t(locale, "index.golive.desc")}</p>
              <ul class="text-xs text-zinc-400 space-y-2">
                <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">✓</span><span>{t(locale, "index.golive.item1")}</span></li>
                <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">✓</span><span>{t(locale, "index.golive.item2")}</span></li>
                <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">✓</span><span>{t(locale, "index.golive.item3")}</span></li>
                <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">✓</span><span>{t(locale, "index.golive.item4")}</span></li>
              </ul>
            </div>
            <div class="flex flex-col items-start gap-3">
              <div>
                <div class="text-3xl font-light text-zinc-100">{t(locale, "index.golive.price")}</div>
                <div class="text-xs text-zinc-500 max-w-[220px] mt-1">{t(locale, "index.golive.priceNote")}</div>
              </div>
              <a href="mailto:info@conendigital.hu?subject=NEXUS%20Go-Live" class="bg-amber-600 hover:bg-amber-500 text-zinc-100 px-5 py-2.5 rounded text-sm font-medium transition-colors">
                {t(locale, "index.golive.cta")}
              </a>
            </div>
          </div>
        </div>

        <!-- ÁSZF checkbox -->
        <div class="flex justify-center mt-8">
          <label class="flex items-start gap-3 cursor-pointer select-none">
            <input
              type="checkbox"
              id="accept-terms-checkout"
              class="accent-emerald-600 w-4 h-4 mt-0.5 flex-shrink-0"
            />
            <span class="text-xs text-zinc-400 leading-relaxed">
              {t(locale, "pricing.termsCheckbox")}
              <a href={localeRelativePath("/aszf", locale)} target="_blank" class="text-emerald-400 hover:text-emerald-300 underline">{t(locale, "footer.terms")}</a>
              {t(locale, "pricing.termsAnd")}
              <a href={localeRelativePath("/adatvedelem", locale)} target="_blank" class="text-emerald-400 hover:text-emerald-300 underline">{t(locale, "footer.privacy")}</a>
              {t(locale, "pricing.termsEnd")}
            </span>
          </label>
        </div>

        <!-- Hibaüzenet helye -->
        <p id="checkout-error" class="hidden text-sm text-red-400 text-center mt-6"></p>

        <p class="text-xs text-zinc-600 text-center mt-4">
          {t(locale, "pricing.paymentInfo")}
        </p>

        <footer class="mt-auto pt-12">
          <div class="border-t border-zinc-800 pt-6 flex flex-wrap items-center justify-between gap-4 text-xs text-zinc-500">
            <div>
              © 2026 {t(locale, "footer.by")}
              <a href="https://conendigital.hu" class="text-emerald-400 hover:text-emerald-300 transition-colors ml-1">
                Conen Digital
              </a>
            </div>
            <div class="flex gap-4">
              <a href={localeRelativePath("/aszf", locale)} class="hover:text-zinc-300 transition-colors">{t(locale, "footer.terms")}</a>
              <a href={localeRelativePath("/adatvedelem", locale)} class="hover:text-zinc-300 transition-colors">{t(locale, "footer.privacy")}</a>
            </div>
          </div>
        </footer>

      </div>
    </div>

    <script define:vars={{
      errorTerms: t(locale, "pricing.errorTerms"),
      redirectingText: t(locale, "pricing.redirecting"),
      errorGeneric: t(locale, "pricing.errorGeneric"),
    }}>
      const errorEl = document.getElementById("checkout-error");

      function showError(msg) {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.classList.remove("hidden");
      }

      const termsCheckbox = document.getElementById("accept-terms-checkout");

      document.querySelectorAll(".checkout-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const tier = btn.dataset.checkoutTier;
          if (!tier) return;

          if (!termsCheckbox?.checked) {
            showError(errorTerms);
            return;
          }

          const originalText = btn.textContent;
          btn.disabled = true;
          btn.textContent = redirectingText;
          errorEl?.classList.add("hidden");

          try {
            const res = await fetch("/api/checkout", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ tier }),
            });

            const data = await res.json();

            if (!res.ok) {
              throw new Error(data.error || "");
            }

            if (data.url) {
              window.location.href = data.url;
            } else {
              throw new Error("");
            }
          } catch (err) {
            const msg = err instanceof Error ? err.message : "";
            showError(`${errorGeneric} ${msg}`);
            btn.disabled = false;
            btn.textContent = originalText;
          }
        });
      });
    </script>
    <BugReport locale={locale} />
  </body>
</html>

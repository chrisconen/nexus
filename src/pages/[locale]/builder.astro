---
import "../../styles/global.css";
import { auth } from "@/lib/auth";
import SiteBuilder from "@/components/SiteBuilder";
import BugReport from "@/components/BugReport.astro";
import { t, type Locale } from "@/lib/i18n/translations";
import { localeRelativePath } from "@/lib/i18n/locale";

const locale = (Astro.currentLocale as Locale) || "hu";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (!session) {
  return Astro.redirect(localeRelativePath("/belepes", locale));
}

const { user } = session;

if (user.tier === "free") {
  return Astro.redirect(localeRelativePath("/arazas", locale));
}
---
<!DOCTYPE html>
<html lang={locale} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t(locale, "builder.title")}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="h-full bg-zinc-950 text-zinc-100 font-mono antialiased m-0">
    <div class="h-screen flex flex-col">
      <SiteBuilder client:load userTier={user.tier} userName={user.name} locale={locale} />
    </div>
    <BugReport locale={locale} />
  </body>
</html>

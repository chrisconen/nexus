---
import "../../styles/global.css";
import { auth } from "@/lib/auth";
import SignOutButton from "@/components/SignOutButton";
import BugReport from "@/components/BugReport.astro";
import { db, user as userTable } from "@/lib/db";
import { eq } from "drizzle-orm";

import { t, type Locale } from "@/lib/i18n/translations";
import { localeRelativePath } from "@/lib/i18n/locale";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

const locale = (Astro.currentLocale as Locale) || "hu";

// Server-side session check
const session = await auth.api.getSession({
  headers: Astro.request.headers,
});
if (!session) {
  return Astro.redirect(localeRelativePath("/belepes", locale));
}

const { user } = session;

// A session user-én nincsenek rajta a billing-mezők — explicit lekérjük
// a teljes rekordot a DB-ből az id alapján.
const [dbUser] = await db
  .select({
    tier: userTable.tier,
    subscriptionStatus: userTable.subscriptionStatus,
    subscriptionPeriodEnd: userTable.subscriptionPeriodEnd,
    cancelAtPeriodEnd: userTable.cancelAtPeriodEnd,
    stripeCustomerId: userTable.stripeCustomerId,
  })
  .from(userTable)
  .where(eq(userTable.id, user.id))
  .limit(1);

// A tier forrása mostantól a friss DB-rekord (a session cache-elt lehet).
const tier = dbUser?.tier ?? user.tier ?? "free";

const tierLabel = {
  free: "Free · NEXUS Basic",
  pro: "Pro · NEXUS Pro",
  premium: "Premium · NEXUS Premium",
}[tier as "free" | "pro" | "premium"] || t(locale, "account.unknownTier");

const isPaid = tier === "pro" || tier === "premium";
const isCanceling = dbUser?.cancelAtPeriodEnd === true;
const isPastDue = dbUser?.subscriptionStatus === "past_due";

const localeMap: Record<Locale, string> = {
  hu: "hu-HU",
  en: "en-US",
  de: "de-DE",
};

const periodEndStr = dbUser?.subscriptionPeriodEnd
  ? new Intl.DateTimeFormat(localeMap[locale], {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date(dbUser.subscriptionPeriodEnd))
  : null;
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t(locale, "account.title")}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-mono antialiased">
    <div class="min-h-screen flex flex-col px-6 py-12">
      <div class="max-w-3xl w-full mx-auto">
        <div class="mb-12 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
            <span class="text-xs uppercase tracking-[0.3em] text-zinc-500">{t(locale, "account.system")}</span>
            <LanguageSwitcher currentLocale={locale} currentPathname={Astro.url.pathname} />
          </div>
          <a href={localeRelativePath("/", locale)} class="text-xs text-zinc-500 hover:text-emerald-400 transition-colors">
            ← {t(locale, "nav.home")}
          </a>
        </div>

        <h1 class="text-4xl font-light mb-2">
          <span class="text-zinc-400">{t(locale, "account.heading")}</span>
          <span class="text-emerald-400">{user.name}</span>
        </h1>
        <p class="text-sm text-zinc-500 mb-12">
          {user.email}
        </p>

        <div class="border border-zinc-800 rounded-lg p-6 mb-6">
          <div class="text-xs uppercase tracking-wider text-zinc-500 mb-3">{t(locale, "account.subscription")}</div>
          <div class="text-lg text-zinc-200">{tierLabel}</div>

          {/* Státusz csak fizetős csomagnál */}
          {isPaid && dbUser?.subscriptionStatus && (
            <div class="text-xs text-zinc-500 mt-2">
              {t(locale, "account.status")}
              <span class="text-zinc-400">
                {dbUser.subscriptionStatus === "active" && t(locale, "account.statusActive")}
                {dbUser.subscriptionStatus === "past_due" && t(locale, "account.statusPastDue")}
                {dbUser.subscriptionStatus === "canceled" && t(locale, "account.statusCanceled")}
              </span>
            </div>
          )}

          {/* Period-végi lemondás — a portál lemondási flow-ja váltja ki */}
          {isPaid && isCanceling && periodEndStr && (
            <div class="mt-4 text-sm text-amber-400/90 border border-amber-500/20 bg-amber-500/5 rounded px-3 py-2">
              {t(locale, "account.cancelingMsg")}
              <strong class="font-medium">{periodEndStr}</strong>{t(locale, "account.cancelingEnd")}
            </div>
          )}

          {/* Aktív, megújulő előfizetés */}
          {isPaid && !isCanceling && !isPastDue && periodEndStr && (
            <div class="mt-3 text-xs text-zinc-600">
              {t(locale, "account.nextBilling")} <span class="text-zinc-500">{periodEndStr}</span>
            </div>
          )}

          {/* Fizetési probléma */}
          {isPastDue && (
            <div class="mt-4 text-sm text-red-400/90 border border-red-500/20 bg-red-500/5 rounded px-3 py-2">
              {t(locale, "account.pastDueMsg")}
            </div>
          )}

          {/* CTA: free → árazás, fizetős → portal */}
          {tier === "free" ? (
            <a href={localeRelativePath("/arazas", locale)} class="inline-block mt-4 text-sm text-emerald-400 hover:text-emerald-300">
              {t(locale, "account.upgrade")}
            </a>
          ) : (
            <form method="POST" action="/api/portal" class="mt-5">
              <button
                type="submit"
                class="inline-block border border-zinc-700 hover:border-emerald-500 hover:text-emerald-400 text-zinc-300 font-medium px-5 py-2.5 rounded transition-colors text-sm"
              >
                {t(locale, "account.manageSub")}
              </button>
            </form>
          )}
        </div>

        <div class="border border-zinc-800 rounded-lg p-6 mb-6">
          <div class="text-xs uppercase tracking-wider text-zinc-500 mb-3">{t(locale, "account.access")}</div>
          <div class="flex flex-wrap gap-3">
            <a href={localeRelativePath("/chat", locale)} class="inline-block bg-emerald-600 hover:bg-emerald-500 text-zinc-100 font-medium px-5 py-2.5 rounded transition-colors text-sm">
              {t(locale, "account.openChat")}
            </a>
            <a href={localeRelativePath("/builder", locale)} class="inline-block border border-emerald-700 hover:bg-emerald-950/40 text-emerald-400 font-medium px-5 py-2.5 rounded transition-colors text-sm">
              {t(locale, "account.openBuilder")}
            </a>
          </div>
        </div>

        <div class="mt-12 pt-8 border-t border-zinc-800">
          <SignOutButton client:load locale={locale} />
        </div>
      </div>
    </div>
    <BugReport locale={locale} />
  </body>
</html>

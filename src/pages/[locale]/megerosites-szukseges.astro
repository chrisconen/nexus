---
import "../../styles/global.css";
import { t, type Locale } from "@/lib/i18n/translations";
import { localeRelativePath } from "@/lib/i18n/locale";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

const locale = (Astro.currentLocale as Locale) || "hu";
const loginPath = localeRelativePath("/belepes", locale);
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t(locale, "verify.title")}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-mono antialiased">
    <div class="min-h-screen flex flex-col items-center justify-center px-6 py-12">
      <div class="max-w-md w-full text-center">

        <div class="mb-8 flex items-center justify-center gap-3">
          <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
          <span class="text-xs uppercase tracking-[0.3em] text-zinc-500">{t(locale, "verify.system")}</span>
          <LanguageSwitcher currentLocale={locale} currentPathname={Astro.url.pathname} />
        </div>

        <h1 class="text-3xl font-light mb-4">
          <span class="text-zinc-300">{t(locale, "verify.heading")}</span>
          <span class="text-emerald-400">{t(locale, "verify.headingAccent")}</span>
        </h1>

        <p class="text-base text-zinc-400 mb-2 leading-relaxed">
          {t(locale, "verify.desc")}
        </p>
        <p class="text-sm text-zinc-500 mb-8 leading-relaxed">
          {t(locale, "verify.help")}
        </p>

        <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-900/50 mb-8 text-left">
          <div class="text-xs uppercase tracking-wider text-emerald-500 mb-3">{t(locale, "verify.nextTitle")}</div>
          <ol class="text-sm text-zinc-400 space-y-2 list-decimal list-inside">
            <li>{t(locale, "verify.step1")}</li>
            <li>{t(locale, "verify.step2")}</li>
            <li>{t(locale, "verify.step3")}</li>
            <li>{t(locale, "verify.step4")}</li>
          </ol>
        </div>

         <a href={loginPath}
          class="text-xs uppercase tracking-wider text-zinc-500 hover:text-emerald-400 transition-colors"
        >
          ← {t(locale, "verify.back")}
        </a>

      </div>
    </div>
  </body>
</html>

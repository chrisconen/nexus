        step5: g('<strong>"Formspree endpoint"</strong> mezőbe', 'Paste the endpoint URL into the <strong>"Formspree endpoint"</strong> field', 'Fügen Sie die Endpunkt-URL in das Feld <strong>"Formspree-Endpunkt"</strong> ein'),
      },
      tip: g(
        "<strong>Tipp:</strong> A Formspree ingyenes tervvel havi 50 beküldést kapsz. A beérkező üzeneteket emailben kapod meg, és a Formspree dashboardon is látod.",
        "<strong>Tip:</strong> Formspree's free plan gives you 50 submissions per month. You'll receive messages via email and can view them on the Formspree dashboard.",
        "<strong>Tipp:</strong> Der kostenlose Formspree-Tarif bietet 50 Übermittlungen pro Monat. Sie erhalten Nachrichten per E-Mail und können sie im Formspree-Dashboard einsehen."
      ),
      warningTitle: g("Formspree nélkül", "Without Formspree", "Ohne Formspree"),
      warningDesc: g(
        "Ha nem adsz meg endpoint-ot, az űrlap megjelenik, de a beküldés nem fog működni — egy figyelmeztető üzenet jelenik meg a látogatónak.",
        "If you don't provide an endpoint, the form will be displayed but submission won't work — a warning message will appear for visitors.",
        "Wenn Sie keinen Endpunkt angeben, wird das Formular angezeigt, aber die Übermittlung funktioniert nicht — eine Warnmeldung erscheint für Besucher."
      ),
    },
    download: {
      title: g("Letöltés & hosting", "Download & Hosting", "Download & Hosting"),
      downloadTitle: g("Letöltés", "Download", "Download"),
      downloadDesc: g(
        'A toolbar-ban a <strong>"Letöltés"</strong> gombra kattintva egy önálló <code>.html</code> fájlt kapsz. Ez tartalmazza:',
        'Clicking the <strong>"Download"</strong> button in the toolbar gives you a standalone <code>.html</code> file. It includes:',
        'Durch Klicken auf die Schaltfläche <strong>"Download"</strong> in der Symbolleiste erhalten Sie eine eigenständige <code>.html</code>-Datei. Sie enthält:'
      ),
      includes: {
        css: g("Az összes CSS-t inline (nincs külső fájl)", "All CSS inline (no external files)", "Alle CSS inline (keine externen Dateien)"),
        fonts: g("Google Fonts betöltést", "Google Fonts loading", "Google Fonts Laden"),
        responsive: g("Reszponzív megjelenést (mobil + desktop)", "Responsive display (mobile + desktop)", "Responsive Darstellung (mobil + desktop)"),
        smoothScroll: g("Smooth scroll navigációt", "Smooth scroll navigation", "Smooth-Scroll-Navigation"),
        hamburger: g("Mobil hamburger menüt", "Mobile hamburger menu", "Mobiles Hamburger-Menü"),
      },
      hostingTitle: g("Hol hostolhatod?", "Where can you host it?", "Wo können Sie es hosten?"),
      hostingItems: {
        github: g("<strong>GitHub Pages</strong> — ingyenes, egyszerű", "<strong>GitHub Pages</strong> — free, simple", "<strong>GitHub Pages</strong> — kostenlos, einfach"),
        netlify: g("<strong>Netlify</strong> — ingyenes tier, drag & drop deploy", "<strong>Netlify</strong> — free tier, drag & drop deploy", "<strong>Netlify</strong> — kostenloser Tarif, Drag & Drop"),
        vercel: g("<strong>Vercel</strong> — ingyenes, automatikus HTTPS", "<strong>Vercel</strong> — free, automatic HTTPS", "<strong>Vercel</strong> — kostenlos, automatisches HTTPS"),
        anyHost: g("<strong>Bármely web hosting</strong> — FTP-vel feltölthető", "<strong>Any web hosting</strong> — upload via FTP", "<strong>Jeder Webhosting</strong> — Hochladen per FTP"),
        ownServer: g("<strong>Saját szerver</strong> — Apache, Nginx", "<strong>Own server</strong> — Apache, Nginx", "<strong>Eigener Server</strong> — Apache, Nginx"),
      },
      tip: g(
        "<strong>Tipp:</strong> A képek (ha feltöltötted a Vercel Blob-ra) külső URL-ről töltődnek be. Ha saját hostingra költözöl, a képeket is le kell töltened és a HTML-ben az URL-eket cserélned.",
        "<strong>Tip:</strong> Images (if uploaded to Vercel Blob) load from external URLs. If you move to your own hosting, you'll need to download the images and update the URLs in the HTML.",
        "<strong>Tipp:</strong> Bilder (wenn auf Vercel Blob hochgeladen) werden von externen URLs geladen. Wenn Sie zu Ihrem eigenen Hosting wechseln, müssen Sie die Bilder herunterladen und die URLs im HTML aktualisieren."
      ),
    },
    shortcuts: {
      title: g("Billentyűparancsok", "Keyboard Shortcuts", "Tastaturkürzel"),
      table: {
        command: g("Parancs", "Command", "Befehl"),
        key: g("Billentyű", "Key", "Taste"),
        undo: g("Visszavonás", "Undo", "Rückgängig"),
        redo: g("Újra", "Redo", "Wiederholen"),
      },
    },
    generalFaq: {
      title: g("GYIK (általános)", "FAQ (General)", "FAQ (Allgemein)"),
      items: {
        q1: {
          q: g("Hány weboldalt készíthetek?", "How many websites can I create?", "Wie viele Websites kann ich erstellen?"),
          a: g("Jelenleg egy weboldalt tároltunk fiókonként. Ha újat szeretnél, az előzőt felülírja az újragenerálás.", "Currently, we store one website per account. If you want a new one, regeneration will overwrite the previous one.", "Derzeit speichern wir eine Website pro Konto. Wenn Sie eine neue möchten, überschreibt die Neugenerierung die vorherige."),
        },
        q2: {
          q: g("Elveszíthetem a munkámat?", "Can I lose my work?", "Kann ich meine Arbeit verlieren?"),
          a: g("Az automatikus mentés 2 másodpercenként menti a változásokat. A Ctrl+Z-vel 30 lépést tudsz visszavonni. Ha bezárod a böngészőt, a legutóbb mentett állapot megmarad.", "Auto-save saves changes every 2 seconds. You can undo up to 30 steps with Ctrl+Z. If you close the browser, the last saved state is preserved.", "Die automatische Speicherung speichert Änderungen alle 2 Sekunden. Sie können bis zu 30 Schritte mit Strg+Z rückgängig machen. Wenn Sie den Browser schließen, bleibt der zuletzt gespeicherte Zustand erhalten."),
        },
        q3: {
          q: g("Használhatok saját betűtípust?", "Can I use custom fonts?", "Kann ich eigene Schriftarten verwenden?"),
          a: g("Jelenleg 8 Google Font közül választhatsz. Egyéni betűtípus támogatás a jövőben érkezik.", "Currently you can choose from 8 Google Fonts. Custom font support is coming in the future.", "Derzeit können Sie aus 8 Google Fonts wählen. Unterstützung für benutzerdefinierte Schriftarten kommt in Zukunft."),
        },
        q4: {
          q: g("Hogyan módosítom az űrlap mezőit?", "How do I modify form fields?", "Wie ändere ich die Formularfelder?"),
          a: g("Az űrlap mezői jelenleg fixek (Név, Email, Üzenet). Egyéni mezők támogatása a jövőben érkezik.", "Form fields are currently fixed (Name, Email, Message). Custom field support is coming in the future.", "Formularfelder sind derzeit festgelegt (Name, E-Mail, Nachricht). Unterstützung für benutzerdefinierte Felder kommt in Zukunft."),
        },
        q5: {
          q: g("Működik mobilon a szerkesztő?", "Does the editor work on mobile?", "Funktioniert der Editor auf mobilen Geräten?"),
          a: g("A szerkesztő desktop-ra optimalizált. Mobilon az előnézet megtekinthető, de a szerkesztés kényelmesebb nagyobb képernyőn.", "The editor is optimized for desktop. The preview can be viewed on mobile, but editing is more comfortable on a larger screen.", "Der Editor ist für Desktop optimiert. Die Vorschau kann auf mobilen Geräten angezeigt werden, aber die Bearbeitung ist auf einem größeren Bildschirm komfortabler."),
        },
        q6: {
          q: g("Mi történik, ha lemondom az előfizetést?", "What happens if I cancel my subscription?", "Was passiert, wenn ich mein Abonnement kündige?"),
          a: g("A meglévő weboldalad megmarad és letölthető marad a periódus végéig. Utána a Builder nem lesz elérhető, de a letöltött HTML fájl örökre a tiéd.", "Your existing website remains and will be downloadable until the end of the period. After that, the Builder won't be available, but the downloaded HTML file is yours forever.", "Ihre bestehende Website bleibt erhalten und bis zum Ende des Zeitraums herunterladbar. Danach ist der Builder nicht mehr verfügbar, aber die heruntergeladene HTML-Datei gehört Ihnen für immer."),
        },
      },
    },
  },

  footer: {
    text: g(
      'NEXUS Site Builder — <a href="https://conendigital.hu" class="text-emerald-500 hover:text-emerald-400">Conen Digital</a>',
      'NEXUS Site Builder — <a href="https://conendigital.hu" class="text-emerald-500 hover:text-emerald-400">Conen Digital</a>',
      'NEXUS Site Builder — <a href="https://conendigital.hu" class="text-emerald-500 hover:text-emerald-400">Conen Digital</a>'
    ),
  },

  searchNoResults: g("Nincs találat", "No results", "Keine Ergebnisse"),
};
---
<!DOCTYPE html>
<html lang={locale} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t(locale, "guide.title")}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-mono antialiased">
    <div class="min-h-screen flex">

      <!-- SIDEBAR NAV -->
      <aside id="sidebar" class="w-72 border-r border-zinc-800 bg-zinc-950 flex-shrink-0 overflow-y-auto fixed inset-y-0 left-0 z-30 transform -translate-x-full md:translate-x-0 md:relative transition-transform">
        <div class="p-5 border-b border-zinc-800">
          <div class="flex items-center justify-between mb-4">
            <a href={localeRelativePath("/", locale)} class="flex items-center gap-2 text-sm text-zinc-400 hover:text-emerald-400 transition-colors">
              ← NEXUS
            </a>
            <LanguageSwitcher currentLocale={locale} currentPathname={Astro.url.pathname} />
          </div>
          <h2 class="text-sm font-medium text-zinc-200 uppercase tracking-wider">{t(locale, "guide.sidebar.gettingStarted")}</h2>
          <p class="text-[10px] text-zinc-600 mt-1">NEXUS Pro Site Builder</p>

          <!-- SEARCH -->
          <div class="mt-4 relative">
            <input
              type="text"
              id="doc-search"
              placeholder={t(locale, "guide.searchPlaceholder")}
              class="w-full bg-zinc-900 border border-zinc-800 rounded px-3 py-2 text-xs text-zinc-100 placeholder-zinc-600 focus:border-emerald-500 focus:outline-none"
            />
            <div id="search-results" class="absolute top-full left-0 right-0 bg-zinc-900 border border-zinc-800 rounded-b mt-0.5 max-h-60 overflow-y-auto hidden z-10"></div>
          </div>
        </div>

        <nav class="p-3 space-y-1 text-xs">
          <div class="text-[10px] uppercase tracking-wider text-zinc-600 px-2 pt-3 pb-1">{t(locale, "guide.sidebar.gettingStarted")}</div>
          <a href="#bevezetes" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.intro")}</a>
          <a href="#elso-lepesek" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.firstSteps")}</a>
          <a href="#ai-generalas" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.aiGeneration")}</a>
          <a href="#felhasznaloi-felulet" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.editorUi")}</a>

          <div class="text-[10px] uppercase tracking-wider text-zinc-600 px-2 pt-4 pb-1">{t(locale, "guide.sidebar.sections")}</div>
          <a href="#hero" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.hero")}</a>
          <a href="#szolgaltatasok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.services")}</a>
          <a href="#rolunk" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.about")}</a>
          <a href="#galeria" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.gallery")}</a>
          <a href="#velemenyek" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.testimonials")}</a>
          <a href="#csapat" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.team")}</a>
          <a href="#ajanlatok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.offers")}</a>
          <a href="#gyik" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.faq")}</a>
          <a href="#cta" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.cta")}</a>
          <a href="#statisztikak" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.stats")}</a>
          <a href="#arazas-szekció" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.pricingSection")}</a>
          <a href="#kapcsolat" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.contact")}</a>
          <a href="#partner-logok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.partners")}</a>

          <div class="text-[10px] uppercase tracking-wider text-zinc-600 px-2 pt-4 pb-1">{t(locale, "guide.sidebar.customization")}</div>
          <a href="#szinpalettak" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.palettes")}</a>
          <a href="#betutipusok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.fonts")}</a>
          <a href="#szekcio-stilusok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.sectionStyles")}</a>
          <a href="#ikonok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.icons")}</a>
          <a href="#kepek" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.images")}</a>

          <div class="text-[10px] uppercase tracking-wider text-zinc-600 px-2 pt-4 pb-1">{t(locale, "guide.sidebar.advanced")}</div>
          <a href="#seo-meta" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.seo")}</a>
          <a href="#social-media" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.social")}</a>
          <a href="#formspree" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.formspree")}</a>
          <a href="#letoltes" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.download")}</a>
          <a href="#billentyuparancsok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.shortcuts")}</a>
          <a href="#gyik-altalanos" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">{t(locale, "guide.sidebar.generalFaq")}</a>
        </nav>
      </aside>

      <!-- MOBILE TOGGLE -->
      <button id="sidebar-toggle" class="fixed top-4 left-4 z-40 md:hidden bg-zinc-900 border border-zinc-800 rounded p-2 text-zinc-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

      <!-- MAIN CONTENT -->
      <main class="flex-1 overflow-y-auto">
        <div class="max-w-3xl mx-auto px-6 md:px-12 py-12">

          <!-- HEADER -->
          <div class="flex items-center justify-between mb-12">
            <div>
              <div class="text-xs uppercase tracking-[0.3em] text-zinc-600 mb-2">{t(locale, "guide.system")}</div>
              <h1 class="text-3xl font-light text-zinc-200">{t(locale, "guide.heading")}</h1>
            </div>
            {isLoggedIn && (
              <a href={localeRelativePath("/builder", locale)} class="text-xs bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2 rounded transition-colors">
                {t(locale, "guide.openBuilder")}
              </a>
            )}
          </div>

          <!-- CONTENT -->
          <div class="doc-content space-y-16">

            <!-- BEVEZETŐ -->
            <section id="bevezetes" class="doc-section">
              <h2>{guideContent.intro.title}</h2>
              <p set:html={guideContent.intro.p1} />

              <div class="tip">
                <span set:html={guideContent.intro.tip} /> <a href={localeRelativePath("/arazas", locale)}>{guideContent.intro.upgradeLink}</a>
              </div>

              <h3>{guideContent.intro.whatYouGet}</h3>
              <ul>
                <li set:html={guideContent.intro.list.aiContent} />
                <li set:html={guideContent.intro.list.sections13} />
                <li set:html={guideContent.intro.list.livePreview} />
                <li set:html={guideContent.intro.list.autoSave} />
                <li set:html={guideContent.intro.list.undoRedo} />
                <li set:html={guideContent.intro.list.htmlDownload} />
              </ul>
            </section>

            <!-- ELSŐ LÉPÉSEK -->
            <section id="elso-lepesek" class="doc-section">
              <h2>{guideContent.firstSteps.title}</h2>

              <h3>{guideContent.firstSteps.step1Title}</h3>
              <p>{guideContent.firstSteps.step1Desc}</p>
              <ul>
                <li set:html={guideContent.firstSteps.step1List.chat} />
                <li set:html={guideContent.firstSteps.step1List.account} />
                <li set:html={guideContent.firstSteps.step1List.direct} />
              </ul>

              <h3>{guideContent.firstSteps.step2Title}</h3>
              <p>{guideContent.firstSteps.step2Desc}</p>
              <ul>
                <li set:html={guideContent.firstSteps.step2List.name} />
                <li set:html={guideContent.firstSteps.step2List.type} />
                <li set:html={guideContent.firstSteps.step2List.services} />
                <li set:html={guideContent.firstSteps.step2List.contacts} />
                <li set:html={guideContent.firstSteps.step2List.tone} />
                <li set:html={guideContent.firstSteps.step2List.palette} />
              </ul>

              <h3>{guideContent.firstSteps.step3Title}</h3>
              <p>{guideContent.firstSteps.step3Desc}</p>

              <div class="tip">
                <span set:html={guideContent.firstSteps.step3Tip} />
              </div>
            </section>

            <!-- AI GENERÁLÁS -->
            <section id="ai-generalas" class="doc-section">
              <h2>{guideContent.aiGeneration.title}</h2>
              <p>{guideContent.aiGeneration.desc}</p>

              <table>
                <thead>
                  <tr><th>{guideContent.aiGeneration.table.plan}</th><th>{guideContent.aiGeneration.table.model}</th><th>{guideContent.aiGeneration.table.quality}</th></tr>
                </thead>
                <tbody>
                  <tr><td>Pro</td><td>DeepSeek V4 Flash</td><td>{guideContent.aiGeneration.table.proQuality}</td></tr>
                  <tr><td>Premium</td><td>Claude Sonnet 4.6</td><td>{guideContent.aiGeneration.table.premiumQuality}</td></tr>
                </tbody>
              </table>

              <h3>{guideContent.aiGeneration.regenerateTitle}</h3>
              <p set:html={guideContent.aiGeneration.regenerateDesc} />

              <div class="warning">
                <strong>{guideContent.aiGeneration.warningTitle}:</strong> {guideContent.aiGeneration.warningDesc}
              </div>
            </section>

            <!-- FELHASZNÁLÓI FELÜLET -->
            <section id="felhasznaloi-felulet" class="doc-section">
              <h2>{guideContent.editorUi.title}</h2>
              <p>{guideContent.editorUi.desc}</p>

              <h3>{guideContent.editorUi.leftPanelTitle}</h3>
              <p>{guideContent.editorUi.leftPanelDesc}</p>
              <ul>
                <li set:html={guideContent.editorUi.leftPanelList.sections} />
                <li set:html={guideContent.editorUi.leftPanelList.styles} />
              </ul>

              <h3>{guideContent.editorUi.activeSectionTitle}</h3>
              <p>{guideContent.editorUi.activeSectionDesc}</p>
              <ul>
                <li set:html={guideContent.editorUi.activeSectionList.move} />
                <li set:html={guideContent.editorUi.activeSectionList.duplicate} />
                <li set:html={guideContent.editorUi.activeSectionList.toggle} />
                <li set:html={guideContent.editorUi.activeSectionList.delete} />
              </ul>

              <h3>{guideContent.editorUi.centerPanelTitle}</h3>
              <p set:html={guideContent.editorUi.centerPanelDesc} />

              <h3>{guideContent.editorUi.rightPanelTitle}</h3>
              <p set:html={guideContent.editorUi.rightPanelDesc} />
            </section>

            <!-- SZEKCIÓK RÉSZLETESEN -->

            <section id="hero" class="doc-section">
              <h2>{guideContent.hero.title}</h2>
              <p>{guideContent.hero.desc}</p>

              <h3>{guideContent.hero.fieldsTitle}</h3>
              <ul>
                <li set:html={guideContent.hero.fields.headline} />
                <li set:html={guideContent.hero.fields.subtitle} />
                <li set:html={guideContent.hero.fields.buttonText} />
                <li set:html={guideContent.hero.fields.buttonLink} />
                <li set:html={guideContent.hero.fields.layout} />
                <li set:html={guideContent.hero.fields.bgImage} />
              </ul>

              <div class="tip">
                <span set:html={guideContent.hero.tip} />
              </div>
            </section>

            <section id="szolgaltatasok" class="doc-section">
              <h2>{guideContent.services.title}</h2>
              <p>{guideContent.services.desc}</p>

              <h3>{guideContent.services.fieldsTitle}</h3>
              <ul>

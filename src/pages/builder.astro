---
import "../styles/global.css";
import { auth } from "@/lib/auth";
import SiteBuilder from "@/components/SiteBuilder";
import BugReport from "@/components/BugReport.astro";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

if (!session) {
  return Astro.redirect("/belepes");
}

const { user } = session;

if (user.tier === "free") {
  return Astro.redirect("/arazas");
}
---
<!DOCTYPE html>
<html lang="hu" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weboldal készítő — NEXUS</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="h-full bg-zinc-950 text-zinc-100 font-mono antialiased m-0">
    <div class="h-screen flex flex-col">
      <SiteBuilder client:load userTier={user.tier} userName={user.name} />
    </div>
    <BugReport />
  </body>
</html>

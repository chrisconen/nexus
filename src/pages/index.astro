---
import "../styles/global.css";
import { auth } from "@/lib/auth";
import BugReport from "@/components/BugReport.astro";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

const isLoggedIn = !!session;
const userName = session?.user?.name;

if (isLoggedIn) {
  return Astro.redirect("/chat");
}

---
<!DOCTYPE html>
<html lang="hu" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="NEXUS — AI chat asszisztens és weboldal készítő magyar kisvállalkozásoknak. Percek alatt kész weboldal, AI-val generálva." />
    <title>NEXUS — AI Chat & Weboldal Készítő</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-mono antialiased m-0 relative overflow-x-hidden">

    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-bottom bg-no-repeat" style="background-image: url('/landing-bg.webp');"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/40 via-zinc-950/60 to-zinc-950/90"></div>
    </div>

    <div class="relative min-h-screen flex flex-col">

      <header class="flex items-center justify-between px-6 py-5 max-w-6xl mx-auto w-full">
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
          <span class="text-xs uppercase tracking-[0.3em] text-zinc-400">NEXUS</span>
        </div>
        <nav class="flex items-center gap-6 text-sm">
          <a href="#funkciok" class="text-zinc-400 hover:text-zinc-200 transition-colors hidden sm:inline">Funkciók</a>
          <a href="#arazas" class="text-zinc-400 hover:text-zinc-200 transition-colors hidden sm:inline">Árazás</a>
          <a href="/utmutato" class="text-zinc-400 hover:text-zinc-200 transition-colors hidden sm:inline">Útmutató</a>
          <a href="/belepes" class="text-zinc-400 hover:text-zinc-200 transition-colors">Belépés</a>
          <a href="/regisztracio" class="bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2 rounded transition-colors">Regisztráció</a>
        </nav>
      </header>

      <!-- HERO -->
      <section class="px-6 py-16 md:py-24 max-w-4xl mx-auto w-full">
        <h1 class="text-5xl md:text-7xl font-light tracking-tight mb-6">
          <span class="text-zinc-300">NEXUS</span>
        </h1>

        <p class="text-xl md:text-2xl text-zinc-300 mb-4 max-w-2xl font-light">
          AI asszisztens & weboldal készítő magyar kisvállalkozásoknak.
        </p>

        <p class="text-base text-zinc-400 max-w-2xl leading-relaxed">
          Kérdezz bármit magyarul, töltsd fel dokumentumaidat, és készíts percek alatt professzionális weboldalt az AI segítségével — kód nélkül.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/regisztracio" class="bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-6 py-3 rounded font-medium transition-colors inline-flex items-center gap-2">
            Ingyenes regisztráció →
          </a>
          <a href="#funkciok" class="border border-zinc-700 hover:border-zinc-500 text-zinc-300 px-6 py-3 rounded font-medium transition-colors">
            Megnézem a funkciókat
          </a>
        </div>
      </section>

      <!-- FUNKCIÓK -->
      <section id="funkciok" class="px-6 py-16 max-w-6xl mx-auto w-full">
        <div class="text-xs uppercase tracking-[0.3em] text-zinc-600 mb-4 text-center">Két eszköz, egy platform</div>
        <h2 class="text-3xl font-light text-center text-zinc-200 mb-12">Mire használhatod a NEXUS-t?</h2>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- AI Chat -->
          <div class="border border-zinc-800 rounded-lg p-8 bg-zinc-950/60 backdrop-blur-sm">
            <div class="text-3xl mb-4">💬</div>
            <h3 class="text-xl text-zinc-200 mb-3">AI Chat Asszisztens</h3>
            <p class="text-sm text-zinc-400 leading-relaxed mb-4">
              Ingyenes, magyar nyelvű mesterséges intelligencia asszisztens. Kérdezz bármit — szövegírás, kód elemzés, üzleti tanácsadás.
            </p>
            <ul class="text-xs text-zinc-400 space-y-2">
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Magyar nyelvű válaszok</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Dokumentum feldolgozás (Pro & Premium)</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Képelemzés (Premium)</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Beszélgetés-előzmények mentése</span></li>
            </ul>
          </div>

          <!-- Site Builder -->
          <div class="border border-emerald-800 rounded-lg p-8 bg-emerald-950/10 backdrop-blur-sm">
            <div class="text-3xl mb-4">🌐</div>
            <h3 class="text-xl text-zinc-200 mb-3">Weboldal Készítő</h3>
            <p class="text-sm text-zinc-400 leading-relaxed mb-4">
              Az AI generál egy komplett weboldalt a vállalkozásodnak. Te csak szerkeszted, amit akarsz — kód nélkül, percek alatt. Pro & Premium
            </p>
            <ul class="text-xs text-zinc-400 space-y-2">
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>AI által generált tartalom és struktúra</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>13 szekciótípus — hero, szolgáltatások, vélemények, GYIK, csapat...</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Élő előnézet szerkesztés közben</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Képfeltöltés, színpaletták, betűtípusok</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Letölthető HTML — bárhol hostolható</span></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ÁRAZÁS -->
      <section id="arazas" class="px-6 py-16 max-w-6xl mx-auto w-full">
        <div class="text-xs uppercase tracking-[0.3em] text-zinc-600 mb-4 text-center">Árazás</div>
        <h2 class="text-3xl font-light text-center text-zinc-200 mb-12">Válaszd ki a csomagodat</h2>

        <div class="grid md:grid-cols-3 gap-6">

          <!-- FREE -->
          <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/60 backdrop-blur-sm flex flex-col">
            <div class="text-xs uppercase tracking-wider text-zinc-500 mb-3">Free</div>
            <div class="text-2xl font-light text-zinc-200 mb-1">Ingyenes</div>
            <div class="text-xs text-zinc-500 mb-6">50 üzenet / nap</div>

            <div class="text-sm text-zinc-300 mb-4">
              <strong class="text-emerald-400">NEXUS AI</strong>
              <span class="text-zinc-500"> · NEXUS v4 Free</span>
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              AI chat és mindennapi asszisztens — ingyenesen. Magyar szövegíró, üzleti stratéga, marketing szakértő és amit akarsz!
            </p>

            <ul class="text-xs text-zinc-400 space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Magyar nyelvű AI asszisztens</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Kód elemzés és tanácsadás</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Üzleti, stratégiai tanácsok</span></li>
              <li class="flex items-start gap-2 text-zinc-600"><span class="mt-0.5">·</span><span>Weboldal készítő — Pro-tól</span></li>
            </ul>

            <a href="/regisztracio" class="block text-center bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2.5 rounded text-sm font-medium transition-colors">
              Ingyenes regisztráció
            </a>
          </div>

          <!-- PRO -->
          <div class="border border-emerald-700 rounded-lg p-6 bg-emerald-950/20 backdrop-blur-sm flex flex-col relative">
            <div class="absolute -top-3 left-6 bg-emerald-600 text-zinc-100 text-xs uppercase tracking-wider px-2 py-1 rounded">
              Népszerű
            </div>
            <div class="text-xs uppercase tracking-wider text-emerald-400 mb-3">Pro</div>
            <div class="text-2xl font-light text-zinc-100 mb-1">3 990 Ft</div>
            <div class="text-xs text-zinc-500 mb-6">/ hó · korlátlan chat</div>

            <div class="text-sm text-zinc-300 mb-4">
              <strong class="text-emerald-400">NEXUS Pro</strong>
              <span class="text-zinc-500"> · NEXUS V4 Flash</span>
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              Felhő alapú AI modell 1M token kontextussal. Teljes weboldal készítő, dokumentum-feldolgozás, AI szekció-átírás.
            </p>

            <ul class="text-xs text-zinc-400 space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Korlátlan chat (1M token kontextus)</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>Weboldal készítő — 10 generálás / hó</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>AI szekció-átírás — 30 / hó</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>PDF/DOCX dokumentum-feldolgozás</span></li>
              <li class="flex items-start gap-2 text-zinc-600"><span class="mt-0.5">·</span><span>Képelemzés — Premium</span></li>
            </ul>

            <a href="/arazas" class="block text-center bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2.5 rounded text-sm font-medium transition-colors">
              Pro választása →
            </a>


---
import "../styles/global.css";
---


<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="NEXUS AI — Conen Digital saját fejlesztésű AI asszisztense. Lokális és cloud modellekkel, magyar piacra szabva." />
    <title>NEXUS AI — Coming Soon | Conen Digital</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-mono antialiased">
    <div class="min-h-screen flex flex-col items-center justify-center px-6 py-12">
      <div class="max-w-2xl w-full">

        <div class="mb-12 flex items-center gap-3">
          <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
          <span class="text-xs uppercase tracking-[0.3em] text-zinc-500">System // Initializing</span>
        </div>

        <h1 class="text-5xl md:text-7xl font-light tracking-tight mb-6">
          <span class="text-zinc-400">NEXUS</span>
          <span class="text-emerald-400">AI</span>
        </h1>

        <p class="text-lg text-zinc-400 mb-2 max-w-xl">
          Conen Digital saját fejlesztésű AI asszisztense.
        </p>

        <p class="text-sm text-zinc-500 mb-12 max-w-xl">
          Lokális és cloud nyílt forrású modellekkel, magyar piacra szabva.
          Ingyenes és előfizetéses változatok.
        </p>

        <div class="border-t border-zinc-800 pt-8 space-y-3">
          <div class="flex items-baseline justify-between text-sm">
            <span class="text-zinc-500">Free tier</span>
            <span class="text-zinc-300">Qwen 3 30B (lokális)</span>
          </div>
          <div class="flex items-baseline justify-between text-sm">
            <span class="text-zinc-500">Pro tier</span>
            <span class="text-zinc-300">DeepSeek V3 (cloud)</span>
          </div>
          <div class="flex items-baseline justify-between text-sm">
            <span class="text-zinc-500">Premium tier</span>
            <span class="text-zinc-300">Claude Sonnet (cloud)</span>
          </div>
        </div>

        <div class="mt-12 text-xs text-zinc-600">
          Várható indulás: 2026. második negyedév
          <br />
          <a href="https://conendigital.hu" class="text-emerald-400 hover:text-emerald-300 transition-colors">
            ← conendigital.hu
          </a>
        </div>

      </div>
    </div>
  </body>
</html>

---
import "../styles/global.css";
import { auth } from "@/lib/auth";
import BugReport from "@/components/BugReport.astro";
import { t, type Locale } from "@/lib/i18n/translations";
import { localeRelativePath } from "@/lib/i18n/locale";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

const isLoggedIn = !!session;
const userName = session?.user?.name;

const locale = (Astro.currentLocale as Locale) || "hu";

if (isLoggedIn) {
  return Astro.redirect("/chat");
}

---
<!DOCTYPE html>
<html lang={locale} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={t(locale, "index.meta.desc")} />
    <title>{t(locale, "index.meta.title")}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-mono antialiased m-0 relative overflow-x-hidden">

    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute inset-0 bg-cover bg-bottom bg-no-repeat" style="background-image: url('/landing-bg.webp');"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/40 via-zinc-950/60 to-zinc-950/90"></div>
    </div>

    <div class="relative min-h-screen flex flex-col">

      <header class="flex items-center justify-between px-6 py-5 max-w-6xl mx-auto w-full">
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
          <span class="text-xs uppercase tracking-[0.3em] text-zinc-400">NEXUS</span>
          <LanguageSwitcher currentLocale={locale} currentPathname={Astro.url.pathname} />
        </div>
        <nav class="flex items-center gap-6 text-sm">
          <a href="#funkciok" class="text-zinc-400 hover:text-zinc-200 transition-colors hidden sm:inline">{t(locale, "nav.features")}</a>
          <a href="#arazas" class="text-zinc-400 hover:text-zinc-200 transition-colors hidden sm:inline">{t(locale, "nav.pricing")}</a>
          <a href={localeRelativePath("/utmutato", locale)} class="text-zinc-400 hover:text-zinc-200 transition-colors hidden sm:inline">{t(locale, "nav.guide")}</a>
          <a href={localeRelativePath("/belepes", locale)} class="text-zinc-400 hover:text-zinc-200 transition-colors">{t(locale, "nav.login")}</a>
          <a href={localeRelativePath("/regisztracio", locale)} class="bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2 rounded transition-colors">{t(locale, "nav.register")}</a>
        </nav>
      </header>

      <!-- HERO -->
      <section class="px-6 py-16 md:py-24 max-w-4xl mx-auto w-full">
        <h1 class="text-5xl md:text-7xl font-light tracking-tight mb-6">
          <span class="text-zinc-300">NEXUS</span>
        </h1>

        <p class="text-xl md:text-2xl text-zinc-300 mb-4 max-w-2xl font-light">
          {t(locale, "index.hero.subtitle")}
        </p>

        <p class="text-base text-zinc-400 max-w-2xl leading-relaxed">
          {t(locale, "index.hero.description")}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a href={localeRelativePath("/regisztracio", locale)} class="bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-6 py-3 rounded font-medium transition-colors inline-flex items-center gap-2">
            {t(locale, "index.hero.cta")}
          </a>
          <a href="#funkciok" class="border border-zinc-700 hover:border-zinc-500 text-zinc-300 px-6 py-3 rounded font-medium transition-colors">
            {t(locale, "index.hero.browse")}
          </a>
        </div>
      </section>

      <!-- FUNKCIÓK -->
      <section id="funkciok" class="px-6 py-16 max-w-6xl mx-auto w-full">
        <div class="text-xs uppercase tracking-[0.3em] text-zinc-600 mb-4 text-center">{t(locale, "index.features.badge")}</div>
        <h2 class="text-3xl font-light text-center text-zinc-200 mb-12">{t(locale, "index.features.title")}</h2>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Site Builder — a fő termék, ezért az első helyen -->
          <div class="border border-emerald-800 rounded-lg p-8 bg-emerald-950/10 backdrop-blur-sm">
            <div class="text-3xl mb-4">🌐</div>
            <h3 class="text-xl text-zinc-200 mb-3">{t(locale, "index.features.builder.title")}</h3>
            <p class="text-sm text-zinc-400 leading-relaxed mb-4">
              {t(locale, "index.features.builder.desc")}
            </p>
            <ul class="text-xs text-zinc-400 space-y-2">
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.features.builder.item1")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.features.builder.item2")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.features.builder.item3")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.features.builder.item4")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.features.builder.item5")}</span></li>
            </ul>
          </div>

          <!-- AI Chat -->
          <div class="border border-zinc-800 rounded-lg p-8 bg-zinc-950/60 backdrop-blur-sm">
            <div class="text-3xl mb-4">💬</div>
            <h3 class="text-xl text-zinc-200 mb-3">{t(locale, "index.features.chat.title")}</h3>
            <p class="text-sm text-zinc-400 leading-relaxed mb-4">
              {t(locale, "index.features.chat.desc")}
            </p>
            <ul class="text-xs text-zinc-400 space-y-2">
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.features.chat.item1")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.features.chat.item2")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.features.chat.item3")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.features.chat.item4")}</span></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ÁRAZÁS -->
      <section id="arazas" class="px-6 py-16 max-w-6xl mx-auto w-full">
        <div class="text-xs uppercase tracking-[0.3em] text-zinc-600 mb-4 text-center">{t(locale, "index.pricing.badge")}</div>
        <h2 class="text-3xl font-light text-center text-zinc-200 mb-12">{t(locale, "index.pricing.title")}</h2>

        <div class="grid md:grid-cols-3 gap-6">

          <!-- FREE -->
          <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/60 backdrop-blur-sm flex flex-col">
            <div class="text-xs uppercase tracking-wider text-zinc-500 mb-3">Free</div>
            <div class="text-2xl font-light text-zinc-200 mb-1">{t(locale, "index.pricing.free.name")}</div>
            <div class="text-xs text-zinc-500 mb-6">{t(locale, "index.pricing.free.limit")}</div>

            <div class="text-sm text-zinc-300 mb-4">
              {t(locale, "index.pricing.free.model")}
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              {t(locale, "index.pricing.free.desc")}
            </p>

            <ul class="text-xs text-zinc-400 space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.free.item1")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.free.item2")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.free.item3")}</span></li>
              <li class="flex items-start gap-2 text-zinc-600"><span class="mt-0.5">·</span><span>{t(locale, "index.pricing.free.item4")}</span></li>
            </ul>

            <a href={localeRelativePath("/regisztracio", locale)} class="block text-center bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2.5 rounded text-sm font-medium transition-colors">
              {t(locale, "index.pricing.free.cta")}
            </a>
          </div>

          <!-- PRO -->
          <div class="border border-emerald-700 rounded-lg p-6 bg-emerald-950/20 backdrop-blur-sm flex flex-col relative">
            <div class="absolute -top-3 left-6 bg-emerald-600 text-zinc-100 text-xs uppercase tracking-wider px-2 py-1 rounded">
              {t(locale, "index.pricing.pro.badge")}
            </div>
            <div class="text-xs uppercase tracking-wider text-emerald-400 mb-3">{t(locale, "index.pricing.pro.name")}</div>
            <div class="text-2xl font-light text-zinc-100 mb-1">{t(locale, "index.pricing.pro.price")}</div>
            <div class="text-xs text-zinc-500 mb-6">{t(locale, "index.pricing.pro.period")}</div>

            <div class="text-sm text-zinc-300 mb-4">
              {t(locale, "index.pricing.pro.model")}
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              {t(locale, "index.pricing.pro.desc")}
            </p>

            <ul class="text-xs text-zinc-400 space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.pro.item1")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.pro.item2")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.pro.item3")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.pro.item4")}</span></li>
              <li class="flex items-start gap-2 text-zinc-600"><span class="mt-0.5">·</span><span>{t(locale, "index.pricing.pro.item5")}</span></li>
            </ul>

            <a href={localeRelativePath("/arazas", locale)} class="block text-center bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2.5 rounded text-sm font-medium transition-colors">
              {t(locale, "index.pricing.pro.cta")}
            </a>
          </div>

          <!-- PREMIUM -->
          <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/60 backdrop-blur-sm flex flex-col relative">
            <div class="absolute -top-3 left-6 bg-amber-600 text-zinc-100 text-xs uppercase tracking-wider px-2 py-1 rounded">
              {t(locale, "index.pricing.premium.badge")}
            </div>
            <div class="text-xs uppercase tracking-wider text-zinc-400 mb-3">{t(locale, "index.pricing.premium.name")}</div>
            <div class="text-2xl font-light text-zinc-100 mb-1">{t(locale, "index.pricing.premium.price")}</div>
            <div class="text-xs text-zinc-500 mb-6">{t(locale, "index.pricing.premium.period")}</div>

            <div class="text-sm text-zinc-300 mb-4">
              {t(locale, "index.pricing.premium.model")}
            </div>

            <p class="text-sm text-zinc-400 leading-relaxed mb-6 flex-1">
              {t(locale, "index.pricing.premium.desc")}
            </p>

            <ul class="text-xs text-zinc-400 space-y-2 mb-6">
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.premium.item1")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.premium.item2")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.premium.item3")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.premium.item4")}</span></li>
              <li class="flex items-start gap-2"><span class="text-emerald-500 mt-0.5">✓</span><span>{t(locale, "index.pricing.premium.item5")}</span></li>
            </ul>

            <div class="block text-center border border-zinc-700 text-zinc-500 px-4 py-2.5 rounded text-sm font-medium cursor-default">
              {t(locale, "index.pricing.premium.cta")}
            </div>
          </div>

        </div>

        <!-- ÉLESÍTÉS CSOMAG -->
        <div class="mt-10 border border-amber-700/60 rounded-lg p-8 bg-amber-950/10 backdrop-blur-sm">
          <div class="flex flex-wrap items-start justify-between gap-6">
            <div class="max-w-xl">
              <div class="text-xs uppercase tracking-[0.2em] text-amber-500 mb-2">{t(locale, "index.golive.badge")}</div>
              <h3 class="text-xl text-zinc-200 mb-3">🚀 {t(locale, "index.golive.title")}</h3>
              <p class="text-sm text-zinc-400 leading-relaxed mb-4">{t(locale, "index.golive.desc")}</p>
              <ul class="text-xs text-zinc-400 space-y-2">
                <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">✓</span><span>{t(locale, "index.golive.item1")}</span></li>
                <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">✓</span><span>{t(locale, "index.golive.item2")}</span></li>
                <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">✓</span><span>{t(locale, "index.golive.item3")}</span></li>
                <li class="flex items-start gap-2"><span class="text-amber-500 mt-0.5">✓</span><span>{t(locale, "index.golive.item4")}</span></li>
              </ul>
            </div>
            <div class="flex flex-col items-start gap-3">
              <div>
                <div class="text-3xl font-light text-zinc-100">{t(locale, "index.golive.price")}</div>
                <div class="text-xs text-zinc-500 max-w-[220px] mt-1">{t(locale, "index.golive.priceNote")}</div>
              </div>
              <a href="mailto:info@conendigital.hu?subject=NEXUS%20%C3%89les%C3%ADt%C3%A9s%20Csomag" class="bg-amber-600 hover:bg-amber-500 text-zinc-100 px-5 py-2.5 rounded text-sm font-medium transition-colors">
                {t(locale, "index.golive.cta")}
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="px-6 py-16 max-w-4xl mx-auto w-full text-center">
        <h2 class="text-2xl font-light text-zinc-200 mb-4">{t(locale, "index.cta.title")}</h2>
        <p class="text-sm text-zinc-400 mb-8 max-w-lg mx-auto">
          {t(locale, "index.cta.desc")}
        </p>
        <a href={localeRelativePath("/regisztracio", locale)} class="bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-8 py-3 rounded font-medium transition-colors inline-flex items-center gap-2">
          {t(locale, "index.cta.button")}
        </a>
      </section>

      <footer class="mt-auto px-6 py-8 max-w-6xl mx-auto w-full">
        <div class="border-t border-zinc-800 pt-6 flex flex-wrap items-center justify-between gap-4 text-xs text-zinc-500">
          <div>
            © 2026 {t(locale, "footer.by")}
            <a href="https://conendigital.hu" class="text-emerald-400 hover:text-emerald-300 transition-colors ml-1">
              Conen Digital
            </a>
          </div>
          <div class="flex gap-4 flex-wrap">
            <a href={localeRelativePath("/utmutato", locale)} class="hover:text-zinc-300 transition-colors">{t(locale, "footer.guide")}</a>
            <a href={localeRelativePath("/aszf", locale)} class="hover:text-zinc-300 transition-colors">{t(locale, "footer.terms")}</a>
            <a href={localeRelativePath("/adatvedelem", locale)} class="hover:text-zinc-300 transition-colors">{t(locale, "footer.privacy")}</a>
            <a href="https://conendigital.hu" class="hover:text-zinc-300 transition-colors">conendigital.hu</a>
          </div>
        </div>
      </footer>

    </div>
    <BugReport locale={locale} />
  </body>
</html>

---
import "../styles/global.css";
import { auth } from "@/lib/auth";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});

const isLoggedIn = !!session;
const userName = session?.user?.name;

if (isLoggedIn) {
  return Astro.redirect("/chat");
}

---
<!DOCTYPE html>
<html lang="hu" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="NEXUS AI — Conen Digital saját fejlesztésű AI asszisztense. Weboldal készítésre tervezve, magyar piacra szabva." />
    <title>NEXUS AI — Conen Digital</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-mono antialiased m-0 relative overflow-x-hidden">

    <div class="fixed inset-0 -z-10 overflow-hidden">
  <div
    class="absolute inset-0 bg-cover bg-bottom bg-no-repeat"
    style="background-image: url('/landing-bg.webp');"
  ></div>
  <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/40 via-zinc-950/60 to-zinc-950/90"></div>
</div>

    <div class="relative min-h-screen flex flex-col">

      <header class="flex items-center justify-between px-6 py-5 max-w-6xl mx-auto w-full">
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
          <span class="text-xs uppercase tracking-[0.3em] text-zinc-400">NEXUS AI</span>
        </div>
        <nav class="flex items-center gap-6 text-sm">
          {isLoggedIn && (
            <span class="text-zinc-500 hidden sm:inline">Üdv, {userName}</span>
            <a href="/chat" class="text-zinc-300 hover:text-emerald-400 transition-colors">Chat</a>
            <a href="/fiok" class="text-zinc-300 hover:text-emerald-400 transition-colors">Fiók</a>
          )}
          {!isLoggedIn && (
            <a href="/belepes" class="text-zinc-400 hover:text-zinc-200 transition-colors">Belépés</a>
            <a href="/regisztracio" class="bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2 rounded transition-colors">Regisztráció</a>
          )}
        </nav>
      </header>

      <section class="px-6 py-16 md:py-24 max-w-4xl mx-auto w-full">
        <h1 class="text-5xl md:text-7xl font-light tracking-tight mb-6">
          <span class="text-zinc-300">NEXUS</span>
          <span class="text-emerald-400">AI</span>
        </h1>

        <p class="text-xl md:text-2xl text-zinc-300 mb-4 max-w-2xl font-light">
          Conen Digital saját fejlesztésű AI asszisztense.
        </p>

        <p class="text-base text-zinc-400 max-w-2xl leading-relaxed">
          Lokális és cloud nyílt forrású modellekkel, magyar piacra szabva.
          Ingyenes és előfizetéses változatok.
        </p>

        {!isLoggedIn && (
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/regisztracio" class="bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-6 py-3 rounded font-medium transition-colors inline-flex items-center gap-2">
              Kezdés ingyenes Free tier-rel →
            </a>
            <a href="/belepes" class="border border-zinc-700 hover:border-zinc-500 text-zinc-300 px-6 py-3 rounded font-medium transition-colors">
              Belépés
            </a>
          </div>
        )}

        {isLoggedIn && (
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/chat" class="bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-6 py-3 rounded font-medium transition-colors inline-flex items-center gap-2">
              Chat megnyitása →
            </a>
          </div>
        )}
      </section>

      <section class="px-6 py-12 max-w-6xl mx-auto w-full">
        <div class="grid md:grid-cols-3 gap-6">

          <div class="border border-zinc-800 rounded-lg p-6 bg-zinc-950/60 backdrop-blur-sm flex flex-col">
            <div class="text-xs uppercase tracking-wider text-zinc-500 mb-3">INGYENES</div>
            <div class="text-2xl font-light text-zinc-200 mb-1">Ingyenes</div>
            <div class="text-xs text-zinc-500 mb-6">korlátlan használat</div>

            <div class="text-sm text-zinc-300 mb-4">
              <span class="text-zinc-500"> · INGYENES </span><strong class="text-emerald-400">NEXUS AI</strong>

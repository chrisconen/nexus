---
import "../styles/global.css";
import SignUpForm from "@/components/SignUpForm";
---
<html lang="hu">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Regisztráció — NEXUS AI</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-mono antialiased">
    <div class="min-h-screen flex flex-col items-center justify-center px-6 py-12">
      <div class="max-w-md w-full">

        <div class="mb-8 flex items-center gap-3">
          <div class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></div>
          <span class="text-xs uppercase tracking-[0.3em] text-zinc-500">System // New User</span>
        </div>

        <h1 class="text-3xl font-light mb-2">
          <span class="text-zinc-400">Csatlakozz</span>
          <span class="text-emerald-400">.</span>
        </h1>
        <p class="text-sm text-zinc-500 mb-8">
          Ingyenes - NEXUS Free - korlátlan használat
        </p>

        <SignUpForm client:load />

        <p class="mt-8 text-xs text-zinc-500 text-center">
          Már van fiókod?
          <a href="/belepes" class="text-emerald-400 hover:text-emerald-300">
            Lépj be →
          </a>
        </p>

      </div>
    </div>
  </body>
</html>

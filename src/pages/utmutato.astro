    <script>
      // Sidebar toggle (mobile)
      const sidebar = document.getElementById("sidebar");
      const toggle = document.getElementById("sidebar-toggle");
      toggle?.addEventListener("click", () => {
        sidebar?.classList.toggle("-translate-x-full");
      });

      // Active nav tracking
      const sections = document.querySelectorAll<HTMLElement>(".doc-section");
      const navLinks = document.querySelectorAll<HTMLAnchorElement>(".doc-nav");

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            navLinks.forEach(l => l.classList.remove("active"));
            const active = document.querySelector(`.doc-nav[href="#${entry.target.id}"]`);
            active?.classList.add("active");
          }
        });
      }, { rootMargin: "-20% 0px -70% 0px" });

      sections.forEach(s => observer.observe(s));

      // Search
      const searchInput = document.getElementById("doc-search") as HTMLInputElement;
      const searchResults = document.getElementById("search-results");

      interface SearchEntry { title: string; id: string; text: string; }

      const searchData: SearchEntry[] = [];
      sections.forEach(s => {
        const h2 = s.querySelector("h2");
        searchData.push({
          title: h2?.textContent || "",
          id: s.id,
          text: s.textContent || "",
        });
      });

      searchInput?.addEventListener("input", () => {
        const q = searchInput.value.toLowerCase().trim();
        if (!q || !searchResults) {
          searchResults?.classList.add("hidden");
          return;
        }

        const matches = searchData.filter(e =>
          e.title.toLowerCase().includes(q) || e.text.toLowerCase().includes(q)
        ).slice(0, 8);

        if (matches.length === 0) {
          searchResults.innerHTML = '<div class="px-3 py-2 text-xs text-zinc-500">Nincs találat</div>';
        } else {
          searchResults.innerHTML = matches.map(m =>
            `<a href="#${m.id}" class="block px-3 py-2 text-xs text-zinc-300 hover:bg-zinc-800 hover:text-emerald-400 transition-colors">${m.title}</a>`
          ).join("");
        }
        searchResults.classList.remove("hidden");
      });

      searchInput?.addEventListener("blur", () => {
        setTimeout(() => searchResults?.classList.add("hidden"), 200);
      });
    </script>

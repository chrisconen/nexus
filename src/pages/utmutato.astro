---
import "../styles/global.css";
import { auth } from "@/lib/auth";
import BugReport from "@/components/BugReport.astro";

const session = await auth.api.getSession({
  headers: Astro.request.headers,
});
const isLoggedIn = !!session;
---
<!DOCTYPE html>
<html lang="hu" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Használati útmutató — NEXUS Site Builder</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 font-mono antialiased">
    <div class="min-h-screen flex">

      <!-- SIDEBAR NAV -->
      <aside id="sidebar" class="w-72 border-r border-zinc-800 bg-zinc-950 flex-shrink-0 overflow-y-auto fixed inset-y-0 left-0 z-30 transform -translate-x-full md:translate-x-0 md:relative transition-transform">
        <div class="p-5 border-b border-zinc-800">
          <a href="/" class="flex items-center gap-2 text-sm text-zinc-400 hover:text-emerald-400 transition-colors mb-4">
            ← NEXUS
          </a>
          <h2 class="text-sm font-medium text-zinc-200 uppercase tracking-wider">Útmutató</h2>
          <p class="text-[10px] text-zinc-600 mt-1">NEXUS Pro Site Builder</p>

          <!-- SEARCH -->
          <div class="mt-4 relative">
            <input
              type="text"
              id="doc-search"
              placeholder="Keresés az útmutatóban..."
              class="w-full bg-zinc-900 border border-zinc-800 rounded px-3 py-2 text-xs text-zinc-100 placeholder-zinc-600 focus:border-emerald-500 focus:outline-none"
            />
            <div id="search-results" class="absolute top-full left-0 right-0 bg-zinc-900 border border-zinc-800 rounded-b mt-0.5 max-h-60 overflow-y-auto hidden z-10"></div>
          </div>
        </div>

        <nav class="p-3 space-y-1 text-xs">
          <div class="text-[10px] uppercase tracking-wider text-zinc-600 px-2 pt-3 pb-1">Kezdőlépések</div>
          <a href="#bevezetes" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Bevezető</a>
          <a href="#elso-lepesek" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Első lépések</a>
          <a href="#ai-generalas" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">AI generálás</a>
          <a href="#felhasznaloi-felulet" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">A szerkesztő felület</a>

          <div class="text-[10px] uppercase tracking-wider text-zinc-600 px-2 pt-4 pb-1">Szekciók</div>
          <a href="#hero" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Hero / Főszekció</a>
          <a href="#szolgaltatasok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Szolgáltatások</a>
          <a href="#rolunk" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Rólunk</a>
          <a href="#galeria" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Galéria</a>
          <a href="#velemenyek" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Vélemények</a>
          <a href="#csapat" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Csapat</a>
          <a href="#ajanlatok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Kiemelt ajánlatok</a>
          <a href="#gyik" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">GYIK</a>
          <a href="#cta" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">CTA Banner</a>
          <a href="#statisztikak" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Statisztikák</a>
          <a href="#arazas-szekció" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Árazás</a>
          <a href="#kapcsolat" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Kapcsolat</a>
          <a href="#partner-logok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Partner logók</a>

          <div class="text-[10px] uppercase tracking-wider text-zinc-600 px-2 pt-4 pb-1">Testreszabás</div>
          <a href="#szinpalettak" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Színpaletták</a>
          <a href="#betutipusok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Betűtípusok</a>
          <a href="#szekcio-stilusok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Szekció stílusok</a>
          <a href="#ikonok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Ikonok</a>
          <a href="#kepek" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Képek kezelése</a>

          <div class="text-[10px] uppercase tracking-wider text-zinc-600 px-2 pt-4 pb-1">Haladó</div>
          <a href="#seo-meta" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">SEO & meta adatok</a>
          <a href="#social-media" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Social media linkek</a>
          <a href="#formspree" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Kapcsolati űrlap (Formspree)</a>
          <a href="#letoltes" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Letöltés & hosting</a>
          <a href="#billentyuparancsok" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">Billentyűparancsok</a>
          <a href="#gyik-altalanos" class="doc-nav block px-2 py-1.5 rounded text-zinc-400 hover:text-zinc-200 hover:bg-zinc-900">GYIK (általános)</a>
        </nav>
      </aside>

      <!-- MOBILE TOGGLE -->
      <button id="sidebar-toggle" class="fixed top-4 left-4 z-40 md:hidden bg-zinc-900 border border-zinc-800 rounded p-2 text-zinc-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>

      <!-- MAIN CONTENT -->
      <main class="flex-1 overflow-y-auto">
        <div class="max-w-3xl mx-auto px-6 md:px-12 py-12">

          <!-- HEADER -->
          <div class="flex items-center justify-between mb-12">
            <div>
              <div class="text-xs uppercase tracking-[0.3em] text-zinc-600 mb-2">NEXUS // Dokumentáció</div>
              <h1 class="text-3xl font-light text-zinc-200">Site Builder Útmutató</h1>
            </div>
            {isLoggedIn && (
              <a href="/builder" class="text-xs bg-emerald-600 hover:bg-emerald-500 text-zinc-100 px-4 py-2 rounded transition-colors">
                Builder megnyitása →
              </a>
            )}
          </div>

          <!-- CONTENT -->
          <div class="doc-content space-y-16">

            <!-- BEVEZETŐ -->
            <section id="bevezetes" class="doc-section">
              <h2>Bevezető</h2>
              <p>A NEXUS Site Builder egy AI-alapú weboldal készítő, amelyet kifejezetten magyar kisvállalkozások számára terveztünk. Segítségével <strong>percek alatt</strong> készíthetsz professzionális megjelenésű weboldalt — programozói tudás nélkül.</p>

              <div class="tip">
                <strong>Pro funkció:</strong> A Site Builder a Pro és Premium előfizetéssel érhető el. <a href="/arazas">Frissíts most →</a>
              </div>

              <h3>Mit kapsz?</h3>
              <ul>
                <li><strong>AI-generált tartalom</strong> — Az AI a vállalkozásod adatai alapján generálja a szövegeket, struktúrát</li>
                <li><strong>13 szekciótípus</strong> — Hero, szolgáltatások, vélemények, csapat, GYIK, és még sok más</li>
                <li><strong>Élő előnézet</strong> — Minden változás azonnal látszik a jobb oldali előnézetben</li>
                <li><strong>Automatikus mentés</strong> — 2 másodperc inaktivitás után automatikusan ment</li>
                <li><strong>Visszavonás/Újra</strong> — Ctrl+Z / Ctrl+Y, max 30 lépés</li>
                <li><strong>HTML letöltés</strong> — Egyetlen, önálló HTML fájl, bárhol hostolható</li>
              </ul>
            </section>

            <!-- ELSŐ LÉPÉSEK -->
            <section id="elso-lepesek" class="doc-section">
              <h2>Első lépések</h2>

              <h3>1. Navigálj a Builder-hez</h3>
              <p>Bejelentkezés után a Builder elérhető:</p>
              <ul>
                <li>A <strong>Chat</strong> oldal fejlécéből → "Site Builder" gomb</li>
                <li>A <strong>Fiók</strong> oldalról → "Weboldal készítő" gomb</li>
                <li>Közvetlenül: <code>/builder</code> URL</li>
              </ul>

              <h3>2. Onboarding kérdéssor</h3>
              <p>Ha még nincs weboldalad, az onboarding kérdéssor fogad. Itt add meg:</p>
              <ul>
                <li><strong>Vállalkozás neve</strong> (kötelező) — pl. "Kovács Fodrászat"</li>
                <li><strong>Típus</strong> (kötelező) — válaszd ki a legmegfelelőbb kategóriát</li>
                <li><strong>Szolgáltatások</strong> — vesszővel elválasztva, pl. "Női hajvágás, Festés, Melír"</li>
                <li><strong>Elérhetőségek</strong> — telefon, cím, nyitvatartás</li>
                <li><strong>Hangnem</strong> — hivatalos, barátságos, vagy játékos</li>
                <li><strong>Színpaletta</strong> — 8 előre definiált paletta közül választhatsz</li>
              </ul>

              <h3>3. Generálás</h3>
              <p>A "Weboldal generálása" gombra kattintva az AI létrehozza a weboldal tartalmát. Ez tartalmazza a szövegeket, szekciók struktúráját, és a választott stílust. A generálás 10-30 másodpercet vesz igénybe.</p>

              <div class="tip">
                <strong>Tipp:</strong> Minél részletesebb adatokat adsz meg, annál jobb eredményt kapsz. A szolgáltatások és elérhetőségek segítik az AI-t releváns tartalom generálásában.
              </div>
            </section>

            <!-- AI GENERÁLÁS -->
            <section id="ai-generalas" class="doc-section">
              <h2>AI generálás</h2>
              <p>A NEXUS Site Builder az előfizetésed szintjéhez tartozó AI modellt használja a tartalom generálásához:</p>

              <table>
                <thead>
                  <tr><th>Csomag</th><th>Modell</th><th>Minőség</th></tr>
                </thead>
                <tbody>
                  <tr><td>Pro</td><td>DeepSeek V4 Flash</td><td>Jó — gyors, hatékony</td></tr>
                  <tr><td>Premium</td><td>Claude Sonnet 4.6</td><td>Kiváló — legárnyaltabb szövegek</td></tr>
                </tbody>
              </table>

              <h3>Újragenerálás</h3>
              <p>Ha nem tetszik az eredmény, a toolbar-ban az <strong>"Újragenerálás"</strong> gombbal új tartalmat kérhetsz — ugyanazokkal az onboarding válaszokkal. Az előző verzió a Ctrl+Z-vel visszahozható.</p>

              <div class="warning">
                <strong>Figyelem:</strong> Az újragenerálás felülírja a jelenlegi tartalmat. Ha vannak kézi szerkesztéseid, azok elvesznek — de a Ctrl+Z-vel visszaállíthatod.
              </div>
            </section>

            <!-- FELHASZNÁLÓI FELÜLET -->
            <section id="felhasznaloi-felulet" class="doc-section">
              <h2>A szerkesztő felület</h2>
              <p>A szerkesztő három fő részből áll:</p>

              <h3>Bal panel — Szekciólista & Stílusok</h3>
              <p>Két fül van:</p>
              <ul>
                <li><strong>Szekciók</strong> — az összes szekció listája, sorrendben. Kattints egy szekcióra a szerkesztéséhez.</li>
                <li><strong>Stílusok</strong> — globális beállítások: színpaletta, betűtípusok, egyéni színek, vállalkozás adatai, SEO, footer, social linkek.</li>
              </ul>

              <h3>Aktív szekció vezérlői</h3>
              <p>Amikor egy szekciót kiválasztasz, megjelennek a műveleti gombok:</p>
              <ul>
                <li><strong>▲ / ▼</strong> — szekció mozgatása fel/le</li>
                <li><strong>⧉</strong> — szekció duplikálása</li>
                <li><strong>●</strong> — szekció ki/bekapcsolása (látható/rejtett)</li>
                <li><strong>✕</strong> — szekció törlése</li>
              </ul>

              <h3>Középső panel — Szekció szerkesztő</h3>
              <p>A kiválasztott szekció mezőit szerkesztheted itt. Minden szekciótípusnak saját mezői vannak. Alul a <strong>szekció stílus</strong> vezérlők találhatók: háttérszín, szövegszín, igazítás, padding, margin.</p>

              <h3>Jobb panel — Élő előnézet</h3>
              <p>A weboldal valós idejű előnézete. Minden változtatás azonnal megjelenik. A toolbar-ban választhatsz <strong>Desktop</strong> vagy <strong>Mobil</strong> nézet között.</p>
            </section>

            <!-- SZEKCIÓK RÉSZLETESEN -->

            <section id="hero" class="doc-section">
              <h2>Hero / Főszekció</h2>
              <p>A weboldal tetején megjelenő, figyelemfelkeltő szekció. Ez az első, amit a látogató lát.</p>

              <h3>Mezők</h3>
              <ul>
                <li><strong>Főcím</strong> — a legfontosabb üzenet, nagy betűmérettel</li>
                <li><strong>Alcím</strong> — kiegészítő szöveg, kisebb betűmérettel</li>
                <li><strong>Gomb szöveg</strong> — CTA gomb felirata, pl. "Foglaljon időpontot"</li>
                <li><strong>Gomb link</strong> — hová mutasson a gomb (pl. #kapcsolat)</li>
                <li><strong>Elrendezés</strong> — Bal / Közép / Jobb igazítás</li>
                <li><strong>Háttérkép</strong> — feltölthetsz képet, ami a hero háttere lesz (gradiens overlay-vel)</li>
              </ul>

              <div class="tip">
                <strong>Tipp:</strong> A hero háttérkép esetén sötét overlay automatikusan generálódik, hogy a szöveg olvasható maradjon. Ha nincs háttérkép, a szekció a háttérszín-beállítást használja.
              </div>
            </section>

            <section id="szolgaltatasok" class="doc-section">
              <h2>Szolgáltatások</h2>
              <p>Szolgáltatásaid vagy termékeid kártya-formátumú megjelenítése.</p>

              <h3>Mezők</h3>
              <ul>
                <li><strong>Szekció cím</strong> — pl. "Szolgáltatásaink"</li>
                <li><strong>Alcím</strong> — opcionális kiegészítő szöveg</li>
                <li><strong>Oszlopok</strong> — 2, 3 vagy 4 oszlopos elrendezés</li>
              </ul>

              <h3>Kártyák mezői</h3>
              <ul>
                <li><strong>Név</strong> — szolgáltatás neve</li>
                <li><strong>Leírás</strong> — rövid bemutató szöveg</li>
                <li><strong>Ár</strong> — opcionális, pl. "5 000 Ft"</li>
                <li><strong>Ikon</strong> — 25 SVG ikon közül választhatsz (olló, autó, szív, stb.)</li>
              </ul>

              <p>A <strong>"+ Szolgáltatás hozzáadása"</strong> gombbal bővítheted a listát, a kártyák <strong>"Törlés"</strong> gombjával csökkentheted.</p>
            </section>

            <section id="rolunk" class="doc-section">
              <h2>Rólunk</h2>
              <p>Bemutatkozó szekció szöveggel és opcionális képpel.</p>

              <h3>Mezők</h3>
              <ul>
                <li><strong>Cím</strong> — pl. "Rólunk"</li>
                <li><strong>Szöveg</strong> — a vállalkozás története, értékei</li>
                <li><strong>Elrendezés</strong> — Szöveg bal (kép jobb), Szöveg jobb (kép bal), Csak szöveg</li>
                <li><strong>Kép</strong> — feltölthető kép a szöveg mellé</li>
              </ul>
            </section>

            <section id="galeria" class="doc-section">
              <h2>Galéria</h2>
              <p>Képgaléria rács elrendezésben. Ideális munkáid, termékeid, üzleted bemutatásához.</p>

              <h3>Mezők</h3>
              <ul>
                <li><strong>Cím és alcím</strong></li>
                <li><strong>Oszlopok</strong> — 2, 3 vagy 4 oszlop</li>
                <li><strong>Képek</strong> — feltölthető képek, mindegyikhez alt szöveg megadható</li>
              </ul>

              <div class="tip">
                <strong>Tipp:</strong> A képek 4:3 arányban jelennek meg, automatikusan levágva. Próbálj hasonló méretű képeket használni a legjobb eredményért.
              </div>
            </section>

            <section id="velemenyek" class="doc-section">
              <h2>Vélemények</h2>
              <p>Ügyfélvélemények megjelenítése csillagos értékeléssel.</p>

              <h3>Mezők véleményenként</h3>
              <ul>
                <li><strong>Név</strong> — az ügyfél neve</li>
                <li><strong>Pozíció</strong> — opcionális, pl. "Visszatérő vendég"</li>
                <li><strong>Vélemény</strong> — a vélemény szövege (idézőjelben jelenik meg)</li>
                <li><strong>Értékelés</strong> — 1-5 csillag</li>
                <li><strong>Profilkép</strong> — opcionális fotó</li>
              </ul>
            </section>

            <section id="csapat" class="doc-section">
              <h2>Csapat</h2>
              <p>Csapattagok bemutatása fotóval, pozícióval, elérhetőséggel.</p>

              <h3>Mezők tagonként</h3>
              <ul>
                <li><strong>Profilkép</strong> — kör alakban jelenik meg</li>
                <li><strong>Név</strong> és <strong>Pozíció</strong></li>
                <li><strong>Bio</strong> — rövid bemutatkozás</li>
                <li><strong>Telefon</strong> és <strong>Email</strong> — kattintható linkekként jelennek meg</li>
              </ul>
            </section>

            <section id="ajanlatok" class="doc-section">
              <h2>Kiemelt ajánlatok</h2>
              <p>Akciók, kedvezmények kiemelésére. Áthúzott eredeti ár + akciós ár + badge.</p>

              <h3>Mezők ajánlatonként</h3>
              <ul>
                <li><strong>Ajánlat neve</strong> és <strong>Leírás</strong></li>
                <li><strong>Eredeti ár</strong> — áthúzva jelenik meg</li>
                <li><strong>Akciós ár</strong> — kiemelt, nagy betűkkel</li>
                <li><strong>Badge</strong> — pl. "AKCIÓ", "-20%", "ÚJ" — sarokba forgatva jelenik meg</li>
              </ul>
            </section>

            <section id="gyik" class="doc-section">
              <h2>GYIK (Gyakran Ismételt Kérdések)</h2>
              <p>Lenyíló kérdés-válasz lista. A látogatók kattintással nyithatják ki a válaszokat.</p>

              <h3>Mezők kérdésenként</h3>
              <ul>
                <li><strong>Kérdés</strong> — a kattintható fejléc</li>
                <li><strong>Válasz</strong> — a lenyíló tartalom</li>
              </ul>

              <div class="tip">
                <strong>SEO tipp:</strong> A GYIK szekció javítja a keresőoptimalizálást, mert a Google FAQ rich result-ként is megjelenítheti.
              </div>
            </section>

            <section id="cta" class="doc-section">
              <h2>CTA Banner</h2>
              <p>Figyelemfelkeltő, cselekvésre ösztönző sáv. Ideális a weboldal közepén vagy vége felé.</p>

              <h3>Mezők</h3>
              <ul>
                <li><strong>Főcím</strong> — pl. "Készen áll?"</li>
                <li><strong>Szöveg</strong> — rövid ösztönző szöveg</li>
                <li><strong>Gomb szöveg</strong> és <strong>Gomb link</strong></li>
                <li><strong>Háttérszín</strong> — egyéni szín a CTA sávnak</li>
              </ul>
            </section>

            <section id="statisztikak" class="doc-section">
              <h2>Statisztikák</h2>
              <p>Számok, eredmények kiemelése nagy, figyelemfelkeltő formátumban.</p>

              <h3>Mezők statisztikánként</h3>
              <ul>
